LIBDIR = ./rust/target/release
STATLIB = $(LIBDIR)/libfrustumR.a
PKG_LIBS = -L$(LIBDIR) -lfrustumR -lws2_32 -lbcrypt -lntdll -lole32 -ld3dcompiler -luserenv

all: C_clean

$(SHLIB): $(STATLIB)

$(STATLIB):
	cargo build --lib --release --manifest-path=./rust/Cargo.toml

C_clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) rust/target
