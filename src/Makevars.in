LIBDIR = ./rust/target/@RUST_TARGET@/release
STATLIB = $(LIBDIR)/libfrustumR.a
PKG_LIBS = -L$(LIBDIR) -lfrustumR @NATIVE_LIBS@

all: C_clean

$(SHLIB): $(STATLIB)

$(STATLIB):
	"@CARGO@" build --lib --release --locked @CARGO_OFFLINE@ --target=@RUST_TARGET@ --manifest-path=./rust/Cargo.toml

C_clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) ./rust/target
